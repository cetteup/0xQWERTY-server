  "bugs": {
    "url": "https://github.com/cetteup/qwerty-server/issues"
  },
  "homepage": "https://github.com/cetteup/qwerty-server#readme",
  "dependencies": {
    "@hapi/boom": "10.0.1",
    "@twurple/api": "6.2.1",
    "@twurple/auth": "6.2.1",
    "@twurple/chat": "6.2.1",
    "express": "4.22.3",
    "nanoid": "3.3.19",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "tslog": "3.3.4"
  },
  "devDependencies": {
    "@tsconfig/recommended": "1.0.13",
    "@types/express": "4.17.25",
    "@types/hapi": "18.0.15",
    "@types/socket.io": "3.0.2",
    "@types/socket.io-client": "1.4.36",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "eslint": "8.57.1",
    "typescript": "5.9.3"
  }

{
  "name": "qwerty-server",
  "version": "1.0.4",
  "description": "Backend for 0xQWERTY-client and chat bot announcing channel point reward redemptions",
  "main": "dist/server.js",
  "engines": {
    "node": "18.20.8"
  },
  "scripts": {
    "build-ts": "tsc -b",
    "start-server": "node dist/server.js",
    "start-bot": "node dist/bot.js",
    "watch-ts": "tsc -w",
    "lint": "npx eslint \"src/**\" --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cetteup/qwerty-server.git"
  },
  "author": "cetteup (me@cetteup.com)",
